{"id": "030F4C", "ptrs": ["20444", "204B0"], "max": 4, "jp": "“", "en": "\"", "status": "done", "note": ""},
{"id": "030F50", "ptrs": ["20448"], "max": 16, "jp": "”を見つけた。", "en": "\" found!", "status": "done", "note": ""},
