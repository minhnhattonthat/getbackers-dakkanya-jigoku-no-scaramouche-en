{"id": "030F78", "ptrs": ["6B12C"], "max": 44, "jp": "銀次「まだ公園から出るわけにはいかないや」", "en": "Ginji: \"I can't leave the park yet.\"", "status": "done", "note": ""},
{"id": "030FA4", "ptrs": ["6B138"], "max": 20, "jp": "蛮「休憩室か……」", "en": "Ban: \"The break room, huh...\"", "status": "done", "note": ""},
{"id": "030FB8", "ptrs": ["6B134"], "max": 48, "jp": "銀次「カギがかかってるみたいだよ、蛮ちゃん」", "en": "Ginji: \"Looks like it's locked, Ban-chan.\"", "status": "done", "note": ""},
{"id": "030FE8", "ptrs": ["6B140"], "max": 36, "jp": "蛮「よし、これで休憩室は開いたぜ」", "en": "Ban: \"Alright, that's the break room open.\"", "status": "done", "note": ""},
{"id": "03100C", "ptrs": ["6B14C"], "max": 48, "jp": "銀次「この倉庫、いかにもって感じじゃない？」", "en": "Ginji: \"Doesn't this storeroom look kinda{br}suspicious?\"", "status": "done", "note": ""},
{"id": "03103C", "ptrs": ["6B148"], "max": 28, "jp": "蛮「カギがかかってんな～」", "en": "Ban: \"Locked up tight~\"", "status": "done", "note": ""},
{"id": "031058", "ptrs": ["6B154"], "max": 48, "jp": "銀次「倉庫、開いたよ！　早速調べてみようよ！」", "en": "Ginji: \"The storeroom's open! Let's go check it{br}out!\"", "status": "done", "note": ""},
{"id": "031088", "ptrs": ["6B15C"], "max": 36, "jp": "蛮「どうやら、入れそうにねーな」", "en": "Ban: \"Looks like we ain't gettin' in.\"", "status": "done", "note": ""},
{"id": "0310AC", "ptrs": ["6B164"], "max": 36, "jp": "蛮「センサーをなんとかしねーと」", "en": "Ban: \"Gotta do somethin' about those{br}sensors.\"", "status": "done", "note": ""},
{"id": "0310D0", "ptrs": ["6B170"], "max": 64, "jp": "蛮「なんなんだよ、この音は………{br}うるさくてこれ以上進めねー」", "en": "Ban: \"What the hell is this noise.........{br}It's so damn loud I can't go any further.\"", "status": "done", "note": ""},
{"id": "031110", "ptrs": ["6B16C"], "max": 28, "jp": "銀次「うわっー、耳が痛い」", "en": "Ginji: \"Waaah, my ears hurt!\"", "status": "done", "note": ""},
{"id": "03112C", "ptrs": ["6B178"], "max": 28, "jp": "蛮「くそっ、開かねーぞ」", "en": "Ban: \"Damn, it won't open.\"", "status": "done", "note": ""},
{"id": "031148", "ptrs": ["6B180"], "max": 28, "jp": "銀次「入れそうもないね」", "en": "Ginji: \"Doesn't look like we can get in.\"", "status": "done", "note": ""},
{"id": "031164", "ptrs": ["6B188"], "max": 44, "jp": "銀次「招き猫を運び込まないとダメそうだね」", "en": "Ginji: \"Looks like we've gotta bring the{br}Maneki-neko in here.\"", "status": "done", "note": ""},
{"id": "031190", "ptrs": ["6B190"], "max": 44, "jp": "花月「ロックされてて、入れないようです」", "en": "Kazuki: \"It's locked. We can't seem to get in.\"", "status": "done", "note": ""},
{"id": "0311BC", "ptrs": ["6B198"], "max": 32, "jp": "卑弥呼「前は、入れたのに～」", "en": "Himiko: \"I could get in before~\"", "status": "done", "note": ""},
{"id": "0311DC", "ptrs": ["6B1A0"], "max": 44, "jp": "士度「店員がどかないと、入れそうにないな」", "en": "Shido: \"Can't get in unless that clerk moves.\"", "status": "done", "note": ""},
{"id": "031208", "ptrs": ["6B1A8"], "max": 60, "jp": "花月「もう少し、公園を調べてみる必要がありそうですね……」", "en": "Kazuki: \"It seems we need to look around the{br}park a bit more...\"", "status": "done", "note": ""},
{"id": "031244", "ptrs": ["6B1B0"], "max": 36, "jp": "銀次「勝手には、入れそうにないよ」", "en": "Ginji: \"I don't think we can just walk in.\"", "status": "done", "note": ""},
{"id": "031268", "ptrs": ["6B1BC"], "max": 48, "jp": "花月「しょうがありません。他をあたりましょう」", "en": "Kazuki: \"That can't be helped. Let's try{br}elsewhere.\"", "status": "done", "note": ""},
{"id": "031298", "ptrs": ["6B1B8"], "max": 32, "jp": "蛮「ちっ、通れそうにねーな」", "en": "Ban: \"Tch, can't get through here.\"", "status": "done", "note": ""},
{"id": "0312B8", "ptrs": ["6B1C8"], "max": 44, "jp": "銀次「時間がないよ。他の通り道を探そう」", "en": "Ginji: \"We're running out of time. Let's find{br}another way through.\"", "status": "done", "note": ""},
{"id": "0312E4", "ptrs": ["6B1C4"], "max": 32, "jp": "士度「なんなんだ、こいつらは」", "en": "Shido: \"What the hell are these guys?\"", "status": "done", "note": ""},
{"id": "031304", "ptrs": ["6B1D0"], "max": 48, "jp": "卑弥呼「警備がきびしくて、行けそうもないよ」", "en": "Himiko: \"Security's too tight. We'll never get{br}past.\"", "status": "done", "note": ""},
{"id": "031334", "ptrs": ["6B1D8"], "max": 20, "jp": "女「ねえ、ねえ」", "en": "Woman: \"Hey, hey.\"", "status": "done", "note": ""},
{"id": "031348", "ptrs": ["6B1E0"], "max": 60, "jp": "「アクセス権がありません。{br}対応した電子キーが必要です」", "en": "\"Access denied.{br}The matching electronic key is required.\"", "status": "done", "note": ""},
{"id": "031384", "ptrs": ["6B1E8"], "max": 56, "jp": "「ロックされています。{br}対応した電子キーが必要です」", "en": "\"Locked.{br}The matching electronic key is required.\"", "status": "done", "note": ""},
{"id": "0313BC", "ptrs": ["6B1F0"], "max": 36, "jp": "卑弥呼「通り抜けできなさそうね」", "en": "Himiko: \"Doesn't look like we can get through.\"", "status": "done", "note": ""},
{"id": "0313E0", "ptrs": ["6B1F8"], "max": 24, "jp": "「ロックされています」", "en": "\"Locked.\"", "status": "done", "note": ""},
{"id": "0313F8", "ptrs": ["6B204"], "max": 40, "jp": "「『最高幹部用ＩＤカード』が必要です」", "en": "\"'Executive ID Card' required.\"", "status": "done", "note": ""},
{"id": "031420", "ptrs": ["6B200", "6B214"], "max": 44, "jp": "「ＩＤ確認不能。{br}アクセス権がありません」", "en": "\"ID not recognized.{br}Access denied.\"", "status": "done", "note": ""},
{"id": "03144C", "ptrs": ["6B20C"], "max": 56, "jp": "「『最高幹部用ＩＤカード』認識。{br}使用を許可します」", "en": "\"'Executive ID Card' recognized.{br}Access granted.\"", "status": "done", "note": ""},
